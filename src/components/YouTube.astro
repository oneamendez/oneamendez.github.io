---
// A YouTube video that loads nothing from Google until it's played: the
// poster is the site's own, and the player comes from youtube-nocookie.com.
// Without `id` it's a placeholder that lists what the video should contain.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	/** The video's ID, the part after watch?v= */
	id?: string;
	title: string;
	poster?: ImageMetadata;
	/** For a placeholder: what the video should show. */
	todo?: string;
}
const { id, title, poster, todo } = Astro.props;
const posterUrl = poster ? (await getImage({ src: poster, width: 1280, format: 'jpeg' })).src : undefined;
---

{
	id ? (
		<figure class="shot">
			<div class="yt" data-id={id} data-title={title}>
				<button type="button" aria-label={`Play: ${title}`}>
					{posterUrl && <img src={posterUrl} alt="" loading="lazy" />}
					<span class="play">▶ {title}</span>
				</button>
			</div>
			<figcaption class="yt-note">Plays from YouTube when you press play.</figcaption>
		</figure>
	) : (
		<figure class="shot">
			<div class="todo todo-empty video" role="img" aria-label={`Placeholder: ${title}`}>
				{posterUrl && <img src={posterUrl} alt="" loading="lazy" />}
				<div class="todo-tag">
					<b>YouTube video to make: {title}</b> · {todo}
				</div>
			</div>
		</figure>
	)
}

<script>
	for (const box of document.querySelectorAll<HTMLElement>('.yt')) {
		box.querySelector('button')?.addEventListener('click', () => {
			const frame = document.createElement('iframe');
			frame.src = `https://www.youtube-nocookie.com/embed/${box.dataset.id}?autoplay=1&rel=0`;
			frame.title = box.dataset.title ?? 'YouTube video';
			frame.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
			frame.referrerPolicy = 'strict-origin-when-cross-origin';
			box.replaceChildren(frame);
		});
	}
</script>
