---
// A short muted loop (8-15 s) from public/media/, which plays only while it's
// on screen, so a visitor downloads just the clips they scroll to. Without
// `src` it's a placeholder: the poster if there is one, with what to record.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	/** e.g. "/media/monitor.mp4", made by npm run media. */
	src?: string;
	poster?: ImageMetadata;
	alt: string;
	caption?: string;
	/** For a placeholder: its letter in the plan and what to record. */
	todo?: string;
}
const { src, poster, alt, caption, todo } = Astro.props;
const posterUrl = poster ? (await getImage({ src: poster, width: 1400, format: 'jpeg' })).src : undefined;
---

<figure class="shot">
	{
		src ? (
			<video
				class="clip"
				src={src}
				poster={posterUrl}
				muted
				loop
				playsinline
				preload="none"
				aria-label={alt}
			/>
		) : posterUrl ? (
			<div class="todo">
				<img src={posterUrl} alt={alt} loading="lazy" />
				<div class="todo-tag">
					<b>Clip to record</b> · {todo}
				</div>
			</div>
		) : (
			<div class="todo todo-empty" role="img" aria-label={`Placeholder: ${alt}`}>
				<strong>Clip to record</strong>
				<span>{todo ?? alt}</span>
			</div>
		)
	}
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
	// Play each clip while it's on screen, pause it when it isn't. People who
	// ask for reduced motion get the poster and the browser's own controls.
	const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
	const seen = new IntersectionObserver(
		(entries) => {
			for (const { target, isIntersecting } of entries) {
				const video = target as HTMLVideoElement;
				if (isIntersecting) video.play().catch(() => {});
				else video.pause();
			}
		},
		{ threshold: 0.4 }
	);
	for (const video of document.querySelectorAll<HTMLVideoElement>('video.clip')) {
		if (reduce) video.controls = true;
		else seen.observe(video);
	}
</script>
