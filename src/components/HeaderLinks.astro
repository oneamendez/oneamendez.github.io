---
// The header's links to the main pages, then Starlight's own social icons.
// On narrow screens the links hide: the menu button shows the sidebar instead.
import Default from '@astrojs/starlight/components/SocialIcons.astro';

const links = [
	{ label: 'Features', href: '/features/' },
	{ label: 'Gallery', href: '/gallery/' },
	{ label: 'Install', href: '/install/' },
	{ label: 'Guides', href: '/guides/jit/' },
];
const path = Astro.url.pathname;
---

<nav class="header-links" aria-label="Main">
	{
		links.map(({ label, href }) => (
			<a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>
				{label}
			</a>
		))
	}
</nav>
<Default />

<style>
	.header-links {
		display: none;
		gap: 1.25rem;
		margin-inline-end: 0.75rem;
	}
	@media (min-width: 72rem) {
		.header-links {
			display: flex;
		}
	}
	.header-links a {
		color: var(--sl-color-gray-2);
		text-decoration: none;
		font-size: var(--sl-text-sm);
		font-weight: 500;
	}
	.header-links a:hover,
	.header-links a[aria-current='page'] {
		color: var(--sl-color-white);
	}
</style>
