---
// A screenshot or photo with its caption. Without `src` it's a placeholder
// that says what to capture, so the preview shows where it goes.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src?: ImageMetadata;
	alt: string;
	caption?: string;
	/** For a placeholder: what the picture should show. */
	todo?: string;
}
const { src, alt, caption, todo } = Astro.props;
---

<figure class="shot">
	{
		src ? (
			<Image src={src} alt={alt} widths={[640, 960, 1400]} sizes="(min-width: 50rem) 50vw, 100vw" />
		) : (
			<div class="todo todo-empty" role="img" aria-label={`Placeholder: ${alt}`}>
				<strong>Screenshot to take</strong>
				<span>{todo ?? alt}</span>
			</div>
		)
	}
	{caption && <figcaption>{caption}</figcaption>}
</figure>
